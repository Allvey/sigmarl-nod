{
    "schema_version": 1,
    "method": "opinion_marl",
    "stage": "sequence",
    "use_opinion_marl": true,
    "base_config": "../base/pilot.json",
    "output_root": "outputs/opinion_pilot/m7_sequence_buffer/",
    "opinion": {
        "conflict_graph": {
            "emit_pair_info": true,
            "candidate_count": 2,
            "pair_feature_dim": 10,
            "prediction_horizon_seconds": 3.0,
            "conflict_distance_meters": 2.0,
            "sensing_distance_meters": 20.0,
            "cpa_epsilon": 1e-06,
            "urgency_time_scale_seconds": 3.0,
            "urgency_distance_scale_meters": 2.0
        },
        "evidence": {
            "hidden_sizes": [128, 128],
            "b_max": 1.0,
            "temperature": 1.0
        },
        "dynamics": {
            "response_rate": 0.5,
            "decay_rate": 1.0,
            "self_reinforcement": 0.5,
            "nonlinear_sensitivity": 1.0
        },
        "residual": {
            "opinion_scale": 1.0,
            "gain": 0.1,
            "max_abs": 0.25,
            "action_index": 0
        },
        "policy_bridge": {
            "enabled": true,
            "mode": "stateful_opinion",
            "base_output_root": "outputs/base_pilot/",
            "freeze_base_actor": true,
            "visualize_agent_id": 0
        },
        "stateful": {
            "enabled": true,
            "evidence_output_root": "outputs/opinion_pilot/m5_direct_evidence/",
            "freeze_evidence": true,
            "zero_threshold": 1e-06
        },
        "sequence_ppo": {
            "enabled": true,
            "source_output_root": "outputs/opinion_pilot/m6_stateful_opinion/",
            "chunk_length": 16,
            "evidence_learning_rate_scale": 0.1,
            "neutral_loss_coefficient": 0.01,
            "magnitude_loss_coefficient": 0.001
        }
    }
}
