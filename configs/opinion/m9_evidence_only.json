{
    "schema_version": 1,
    "method": "opinion_marl",
    "stage": "joint",
    "use_opinion_marl": true,
    "base_config": "../../config.json",
    "output_root": "outputs/opinion/m9_evidence_only/",
    "opinion": {
        "conflict_graph": {
            "emit_pair_info": true,
            "candidate_count": 2,
            "pair_feature_dim": 10,
            "prediction_horizon_seconds": 3,
            "conflict_distance_meters": 2,
            "sensing_distance_meters": 20,
            "cpa_epsilon": 0.000001,
            "urgency_time_scale_seconds": 3,
            "urgency_distance_scale_meters": 2
        },
        "evidence": {
            "hidden_sizes": [
                128,
                128
            ],
            "b_max": 1,
            "temperature": 1
        },
        "dynamics": {
            "response_rate": 0.5,
            "decay_rate": 1,
            "self_reinforcement": 0.5,
            "nonlinear_sensitivity": 1
        },
        "residual": {
            "opinion_scale": 1,
            "gain": 0.1,
            "max_abs": 0.25,
            "action_index": 0
        },
        "policy_bridge": {
            "enabled": true,
            "mode": "stateful_opinion",
            "base_output_root": "outputs/base/",
            "freeze_base_actor": true,
            "visualize_agent_id": 0
        },
        "stateful": {
            "enabled": true,
            "evidence_output_root": null,
            "freeze_evidence": false,
            "zero_threshold": 0.000001
        },
        "sequence_ppo": {
            "enabled": true,
            "train_evidence": true,
            "source_output_root": null,
            "chunk_length": 16,
            "evidence_learning_rate_scale": 0.1,
            "neutral_loss_coefficient": 0.01,
            "magnitude_loss_coefficient": 0.001
        },
        "trainer": {
            "enabled": true,
            "mode": "evidence_only",
            "initialization": "base",
            "source_output_root": null,
            "evidence_warmup_iterations": 0,
            "base_actor_learning_rate_scale": 1.0,
            "critic_learning_rate_scale": 1,
            "base_anchor_coefficient": 0,
            "checkpoint_interval": 50
        }
    }
}
